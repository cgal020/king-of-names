# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser.

# Supabase: Project Settings > API Keys.
# New projects show a "publishable" key (sb_publishable_...) and a "secret" key
# (sb_secret_...). Older projects show "anon" and "service_role". Either pair works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI audio transcription (server only). gpt-transcribe is OpenAI's recommended
# model (Oct 2026) and takes keyword and language hints.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
# Comma-separated ISO 639-1 codes of the languages notes are spoken in.
TRANSCRIPTION_LANGUAGES=en

# Anthropic field extraction and business-card reading (server only). The brief asks
# for a small, fast model; Claude Haiku 4.5 supports structured outputs and images.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5

# Mapbox. The public token draws the map in the browser and must be URL-restricted
# to the production and preview domains. The server token is used for reverse
# geocoding and is never sent to the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: a Mapbox Studio style URL instead of Mapbox Standard. "blank" draws no tiles (tests).
NEXT_PUBLIC_MAPBOX_STYLE=
MAPBOX_SERVER_TOKEN=

NEXT_PUBLIC_APP_NAME=King of Names
# The app's public address, for links in password reset emails (e.g. https://kingofnames.app).
# Optional locally; falls back to the address the request came from.
NEXT_PUBLIC_SITE_URL=
