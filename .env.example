# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser.

# Supabase: Project Settings > API Keys.
# New projects show a "publishable" key (sb_publishable_...) and a "secret" key
# (sb_secret_...). Older projects show "anon" and "service_role". Either pair works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI audio transcription (server only).
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=

# Anthropic field extraction (server only).
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=

# Mapbox. The public token draws the map in the browser and must be URL-restricted
# to the production and preview domains. The server token is used for reverse
# geocoding and is never sent to the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SERVER_TOKEN=

NEXT_PUBLIC_APP_NAME=PeopleMap
